# 環境變數範例檔 —— 僅說明「需要哪些環境變數名稱」，所有值皆為佔位文字
# <請填入>，本檔案不包含、也絕不可包含任何實際密碼、雜湊值或密鑰真實數值。
#
# 使用方式：
#   本機測試：複製一份為 .env（.env 已列入 .gitignore，不會被提交版控），
#             將下列 <請填入> 換成實際測試用的值。
#   正式部署（Render）：不使用 .env 檔案，改於 Render Dashboard 的
#             Environment Variables 頁籤逐一設定下列同名變數。

# 固定登入帳號名稱
AUTH_USERNAME=<請填入>

# 登入密碼的雜湊值（由 werkzeug.security.generate_password_hash() 產生，
# 絕對不可填入明文密碼）
AUTH_PASSWORD_HASH=<請填入>

# Google Authenticator TOTP 密鑰（由 pyotp.random_base32() 產生的 base32 字串）
AUTH_TOTP_SECRET=<請填入>

# Flask session 簽章用密鑰（由 secrets.token_hex(32) 等方式產生的高強度隨機值）
FLASK_SECRET_KEY=<請填入>

# 執行環境旗標：正式環境（Render）請設定為 production，
# 用於決定 session cookie 是否強制 Secure 屬性、以及啟動時是否強制檢查
# 上述登入設定皆已齊全。本機開發測試（http）請勿設定為 production，
# 或直接省略此變數。
FLASK_ENV=<請填入，例如 production 或 development>
